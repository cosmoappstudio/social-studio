{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "default",
    "allow": ["Bash(git status*)", "Bash(git diff*)", "Bash(git log*)", "Bash(ls*)", "Bash(npm test*)", "Bash(npm run lint*)", "Bash(npx tsc*)"],
    "deny": [
      "Bash(rm -rf *)", "Bash(rm -fr *)", "Bash(git push --force*)", "Bash(git push -f *)", "Bash(git reset --hard*)", "Bash(git clean -f*)",
      "Read(./.env)", "Read(./.env.*)", "Read(**/*.p8)", "Read(**/*.pem)"
    ]
  },
  "hooks": {
    "SessionStart": [{ "hooks": [{ "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh\"" }] }],
    "PreToolUse": [{ "matcher": "Bash", "hooks": [
      { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-bash.sh\"" },
      { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/validate-commit.sh\"" }
    ] }],
    "PostToolUse": [{ "matcher": "Write|Edit", "hooks": [{ "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/post-edit-note.sh\"" }] }]
  }
}
